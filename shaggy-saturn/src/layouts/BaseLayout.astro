---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import theme from "../config/theme.json";
import "../styles/main.css";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";

const { pageTitle, fullWidth = false } = Astro.props;

const fontEntries = Object.entries(theme.fonts.font_family).filter(
  ([key]) => !key.includes("_type"),
);
---
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {
      fontEntries.map(([key]) => {
        const cssVar = `--font-${key}`;
        return <Font cssVariable={cssVar as "--font-primary"} preload />;
      })
    }
    <title>{pageTitle}</title>
    <ClientRouter />
    <script is:inline>
      (() => {
        if (window.__themeInit) return;
        window.__themeInit = true;
        const applyTheme = () => {
          let stored = "";
          try {
            stored = localStorage.getItem("theme") ?? "";
          } catch {
            /* localStorage недоступен — берём системную тему */
          }
          const theme = ["dark", "light"].includes(stored)
            ? stored
            : window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
          document.documentElement.classList.toggle("dark", theme === "dark");
          document.documentElement.classList.add("js");
        };
        applyTheme();
        // ClientRouter заменяет атрибуты <html> при навигации — возвращаем тему
        document.addEventListener("astro:after-swap", applyTheme);
      })();
    </script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <Header />
    <main
      id="main-content"
      class:list={["flex-1", !fullWidth && "container section-sm"]}
    >
      <slot />
    </main>
    <Footer />
  </body>
</html>
