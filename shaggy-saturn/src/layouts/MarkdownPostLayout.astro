---
import BaseLayout from "./BaseLayout.astro";

const { frontmatter } = Astro.props;

const formattedDate = frontmatter.pubDate
  ? new Date(frontmatter.pubDate).toLocaleDateString("ru-RU", {
      day: "numeric",
      month: "long",
      year: "numeric",
    })
  : null;

const imageClasses =
  frontmatter.image?.variant === "round"
    ? "mx-auto mt-6 size-48 rounded-full object-cover"
    : "mt-6 w-full max-w-xl rounded-lg";
---

<BaseLayout pageTitle={frontmatter.title}>
  <div class="mx-auto max-w-2xl">
    <a
      href="/blog/"
      class="btn-link mb-6 inline-flex items-center text-text-dark"
    >
      <svg
        class="mr-2"
        width="16"
        height="8"
        viewBox="0 0 16 8"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          d="M0.646447 3.64645C0.451184 3.84171 0.451184 4.15829 0.646447 4.35355L3.82843 7.53553C4.02369 7.7308 4.34027 7.7308 4.53553 7.53553C4.7308 7.34027 4.7308 7.02369 4.53553 6.82843L1.70711 4L4.53553 1.17157C4.7308 0.976311 4.7308 0.659728 4.53553 0.464466C4.34027 0.269204 4.02369 0.269204 3.82843 0.464466L0.646447 3.64645ZM16 4.5H1V3.5H16V4.5Z"
        ></path>
      </svg>
      Назад к блогу
    </a>

    <header class="mb-10 border-b border-border pb-8">
      <h1>{frontmatter.title}</h1>
      {
        frontmatter.description && (
          <p class="text-primary mt-3 text-lg">{frontmatter.description}</p>
        )
      }
      <div class="text-text mt-4 flex flex-wrap gap-x-4 gap-y-1 text-sm">
        {
          formattedDate && (
            <time datetime={frontmatter.pubDate.toISOString()}>
              {formattedDate}
            </time>
          )
        }
        {frontmatter.author && <span>{frontmatter.author}</span>}
      </div>
      {
        frontmatter.image && (
          <img
            class={imageClasses}
            src={frontmatter.image.url}
            width={frontmatter.image.variant === "round" ? 192 : 600}
            height={frontmatter.image.variant === "round" ? 192 : undefined}
            alt={frontmatter.image.alt}
          />
        )
      }
      {
        frontmatter.tags?.length > 0 && (
          <div class="tags mt-6">
            {frontmatter.tags.map((tag: string) => (
              <span class="tag">
                <a href={`/tags/${tag}`}>{tag}</a>
              </span>
            ))}
          </div>
        )
      }
    </header>

    <article class="content">
      <slot />
    </article>
  </div>
</BaseLayout>
