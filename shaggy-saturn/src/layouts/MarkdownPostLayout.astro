---
import BaseLayout from "./BaseLayout.astro";

const { frontmatter } = Astro.props;

const formattedDate = frontmatter.pubDate
  ? new Date(frontmatter.pubDate).toLocaleDateString("ru-RU", {
      day: "numeric",
      month: "long",
      year: "numeric",
    })
  : null;
---

<BaseLayout pageTitle={frontmatter.title}>
  <header class="mb-10 border-b border-border pb-8">
    <h1>{frontmatter.title}</h1>
    {
      frontmatter.description && (
        <p class="text-primary mt-3 text-lg">{frontmatter.description}</p>
      )
    }
    <div class="text-text mt-4 flex flex-wrap gap-x-4 gap-y-1 text-sm">
      {formattedDate && <time datetime={frontmatter.pubDate.toISOString()}>{formattedDate}</time>}
      {frontmatter.author && <span>{frontmatter.author}</span>}
    </div>
    {
      frontmatter.image && (
        <img
          class="mt-6 w-full max-w-xl rounded-lg"
          src={frontmatter.image.url}
          width="600"
          alt={frontmatter.image.alt}
        />
      )
    }
    {
      frontmatter.tags?.length > 0 && (
        <div class="tags mt-6">
          {
            frontmatter.tags.map((tag: string) => (
              <span class="tag">
                <a href={`/tags/${tag}`}>{tag}</a>
              </span>
            ))
          }
        </div>
      )
    }
  </header>

  <article class="content">
    <slot />
  </article>
</BaseLayout>
