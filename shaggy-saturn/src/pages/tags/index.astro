---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { slugifyTag } from "../../scripts/slugify";

const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const tags = [...new Set(allPosts.flatMap((post) => post.data.tags))].sort();

const pageTitle = "Теги";
---

<BaseLayout pageTitle={pageTitle}>
  <header class="mb-10">
    <h1>{pageTitle}</h1>
    <p class="text-text mt-3">Все темы блога в одном месте.</p>
  </header>

  <div class="tags">
    {
      tags.map((tag) => (
        <a class="tag no-underline" href={`/tags/${slugifyTag(tag)}/`}>
          {tag}
        </a>
      ))
    }
  </div>
</BaseLayout>
