---
import { getCollection } from "astro:content";
import BlogPost from "../components/BlogPost.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { readingTime } from "../scripts/readingTime";

const allPosts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const pageBlogTitle = "Блог";
---

<BaseLayout pageTitle={pageBlogTitle}>
  <header class="mb-10">
    <h1>{pageBlogTitle}</h1>
    <p class="text-text mt-3">Заметки о разработке и обучении.</p>
  </header>

  <div class="grid gap-6 md:grid-cols-2">
    {
      allPosts.map((post) => (
        <BlogPost
          url={`/posts/${post.id}/`}
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          minutes={readingTime(post.body ?? "")}
          tags={post.data.tags}
          image={post.data.image}
        />
      ))
    }
  </div>
</BaseLayout>
