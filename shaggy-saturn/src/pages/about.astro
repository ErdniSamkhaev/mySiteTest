---
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "Обо мне";

const identity = {
  firstName: "Эрдни",
  country: "России",
  city: "Москве",
  occupation: "Фронтенд-разработчиком",
  hobbies: ["анжумания", "поутрам бегат", "кушац лублу"],
  bio: "Веду блог и делюсь заметками.",
  github: "https://github.com/ErdniSamkhaev?tab=repositories",
};

const skills = ["HTML", "CSS", "JavaScript", "Vue.js", "Astro", "Node.js"];
---

<BaseLayout
  pageTitle={pageTitle}
  description="Эрдни Самхаев — фронтенд-разработчик из Москвы. Веду блог и делюсь заметками."
>
  <article class="content mx-auto max-w-3xl">
    <div class="flex flex-col items-center gap-8 sm:flex-row sm:items-start">
      <img
        src="/images/me2.webp"
        width={192}
        height={192}
        alt={`Фото ${identity.firstName}`}
        class="size-48 shrink-0 rounded-full object-cover"
      />

      <section aria-labelledby="about-heading" class="min-w-0 text-center sm:text-left">
        <h1 id="about-heading">{pageTitle}</h1>
        <p>Меня зовут {identity.firstName}.</p>
        <p>Живу в {identity.city}, работаю {identity.occupation}.</p>
        <p>Хобби: {identity.hobbies.join(", ")}.</p>
        <p>{identity.bio}</p>
      </section>
    </div>

    <section aria-labelledby="skills-heading" class="mt-10">
      <h2 id="skills-heading">Навыки</h2>
      <div class="not-prose">
        <ul class="tags mt-4" role="list">
          {skills.map((skill) => (
            <li class="tag">{skill}</li>
          ))}
        </ul>
      </div>
    </section>
  </article>
</BaseLayout>
