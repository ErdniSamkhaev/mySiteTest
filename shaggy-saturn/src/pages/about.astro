---
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "Обо мне";

const identity = {
  firstName: "Эрдни",
  country: "России",
  occupation: "Frontend Developer",
  hobbies: ["programming", "reading", "traveling"],
};

const skills = ["HTML", "CSS", "JavaScript", "Vue.js", "Astro", "Node.js"];
---

<BaseLayout pageTitle={pageTitle}>
  <article class="content mx-auto max-w-3xl">
    <h1>{pageTitle}</h1>
    <p>Я фронтенд-разработчик, меня зовут {identity.firstName}.</p>
    <p>Живу в {identity.country}, работаю {identity.occupation}.</p>
    <p>Хобби: {identity.hobbies.join(", ")}.</p>

    <h2 class="mt-10">Навыки</h2>
    <div class="tags mt-4">
      {skills.map((skill) => (
        <span class="tag">{skill}</span>
      ))}
    </div>
  </article>
</BaseLayout>
