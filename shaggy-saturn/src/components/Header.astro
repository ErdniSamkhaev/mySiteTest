---
import ThemeIcon from "./ThemeIcon.astro";

const { pathname } = Astro.url;

const navLinks = [
  { name: "Главная", url: "/" },
  { name: "Обо мне", url: "/about/" },
  { name: "Блог", url: "/blog/" },
  { name: "Теги", url: "/tags/" },
];

function isActive(url: string) {
  if (url === "/") {
    return pathname === "/" || pathname === "";
  }
  return pathname.startsWith(url.replace(/\/$/, ""));
}
---

<header class="border-b border-border pb-4 pt-6 md:pt-10">
  <nav class="navbar container flex flex-wrap items-center gap-3">
    {/* Бургер без JS: checkbox-хак (правила в safe.css).
        sr-only вместо hidden — чекбокс остаётся фокусируемым с клавиатуры */}
    <input id="nav-toggle" type="checkbox" class="peer sr-only" />

    <div class="order-1 flex items-center gap-3 md:mr-auto">
      <ThemeIcon />
      <a href="/" class="navbar-brand no-underline">
        <span class="size-2.5 rounded-full bg-primary" aria-hidden="true"></span>
        Erdni
      </a>
    </div>

    <label
      for="nav-toggle"
      class="nav-toggle order-2 ml-auto inline-flex cursor-pointer items-center justify-center peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 md:hidden"
      aria-label="Открыть меню"
    >
      <svg
        id="show-button"
        class="block h-[22px] w-[22px] fill-current"
        viewBox="0 0 20 20"
        aria-hidden="true"
      >
        <path d="M0 3h20v2H0V3zm0 6h20v2H0V9zm0 6h20v2H0V0z"></path>
      </svg>
      <svg
        id="hide-button"
        class="hidden h-[22px] w-[22px] fill-current"
        viewBox="0 0 20 20"
        aria-hidden="true"
      >
        <polygon
          points="11 9 22 9 22 11 11 11 11 22 9 22 9 11 -2 11 -2 9 9 9 9 -2 11 -2"
          transform="rotate(45 10 10)"></polygon>
      </svg>
    </label>

    <ul
      id="nav-menu"
      class="navbar-nav order-3 hidden w-full md:order-2 md:ml-auto md:flex md:w-auto md:flex-row md:items-center md:justify-end md:gap-1"
    >
      {
        navLinks.map((link) => (
          <li class="nav-item">
            <a
              href={link.url}
              class:list={[
                "nav-link inline-block",
                isActive(link.url) && "nav-link-active",
              ]}
            >
              {link.name}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
