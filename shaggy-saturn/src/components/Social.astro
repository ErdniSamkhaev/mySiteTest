---
const links = [
  {
    label: "GitHub",
    href: "https://github.com/ErdniSamkhaev?tab=repositories",
  },
  {
    label: "Telegram",
    href: "https://t.me/safe_route_notes",
  },
];
---

<div class="flex flex-wrap justify-center gap-3">
  {
    links.map((link) => (
      <a
        href={link.href}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary no-underline"
      >
        {link.label}
      </a>
    ))
  }
</div>
