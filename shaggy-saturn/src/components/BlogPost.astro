---
/**
 * Карточка поста v2 (хэндофф «Эволюция 3D»).
 * Кликабельна целиком через stretched link: <a> заголовка растянут псевдоэлементом
 * after:inset-0 на всю карточку, а теги подняты над ним (z-10), чтобы оставаться
 * отдельными ссылками — вложенные <a> в HTML недопустимы.
 */
import { slugifyTag } from "../scripts/slugify";

interface Props {
  url: string;
  title: string;
  description?: string;
  pubDate?: Date | string;
  minutes?: number;
  tags?: string[];
  image?: { url: string; alt: string; variant?: string };
}

const { title, url, description, pubDate, minutes, tags = [], image } = Astro.props;

const formattedDate = pubDate
  ? new Date(pubDate)
      .toLocaleDateString("ru-RU", {
        day: "numeric",
        month: "long",
        year: "numeric",
      })
      .replace(/\s*г\.$/, "")
  : null;
---

<article
  class="post-card reveal group relative flex h-full flex-col overflow-hidden rounded-xl border border-border bg-surface transition duration-200 hover:-translate-y-[5px] hover:border-primary hover:shadow-[0_16px_36px_rgba(0,0,0,0.35)]"
  data-reveal
>
  {
    image?.url ? (
      <img
        src={image.url}
        alt=""
        width="600"
        height="338"
        loading="lazy"
        decoding="async"
        class="aspect-video w-full object-cover"
      />
    ) : (
      <div class="post-cover-placeholder aspect-video w-full" aria-hidden="true" />
    )
  }

  <div class="flex flex-1 flex-col gap-2.5 px-5 pb-5 pt-5 lg:px-[22px] lg:pb-[22px]">
    <p class="m-0 flex gap-2 whitespace-nowrap text-[13px] text-meta">
      {
        formattedDate && (
          <time datetime={new Date(pubDate!).toISOString()}>{formattedDate}</time>
        )
      }
      {formattedDate && minutes && <span aria-hidden="true">·</span>}
      {minutes && <span>{minutes} мин</span>}
    </p>

    <h2 class="m-0 font-secondary text-[17px] font-medium leading-[1.35]">
      <a
        href={url}
        class="text-text-dark no-underline after:absolute after:inset-0 focus-visible:outline-none"
      >
        {title}
      </a>
    </h2>

    {description && <p class="m-0 flex-1 text-sm leading-[1.55] text-text">{description}</p>}

    {
      tags.length > 0 && (
        <div class="tags relative z-10">
          {tags.map((tag: string) => (
            <a class="tag no-underline" href={`/tags/${slugifyTag(tag)}/`}>
              {tag}
            </a>
          ))}
        </div>
      )
    }
  </div>
</article>
